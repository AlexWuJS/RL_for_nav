<robot name="mycar" xmlns:xacro="http://wiki.ros.org/xacro">

    <xacro:property name="footprint_radius" value="0.001" />
    <!-- 1.添加 base_footprint -->
    <link name="base_footprint">
        <visual>
            <geometry>
                <sphere radius="${footprint_radius}" />
            </geometry>
        </visual>
    </link>

    <!-- 2. USV 船体参数 -->
    <xacro:property name="hull_length" value="0.3" />
    <xacro:property name="hull_width" value="0.15" />
    <xacro:property name="hull_height" value="0.1" />
    <xacro:property name="hull_mass" value="2.0" />
    <xacro:property name="hull_joint_z" value="${hull_height / 2}" />

    <!-- 向后兼容: 其他xacro文件(如laser)仍使用base_length -->
    <xacro:property name="base_length" value="${hull_length}" />
    <xacro:property name="base_radius" value="${hull_width / 2}" />

    <!-- 2.1 船体 link -->
    <link name="base_link">
        <visual>
            <geometry>
                <box size="${hull_length} ${hull_width} ${hull_height}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <material name="hull_color">
                <color rgba="0.2 0.5 0.8 0.5" />
            </material>
        </visual>
        <collision>
            <geometry>
                <box size="${hull_length} ${hull_width} ${hull_height}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </collision>
        <!-- USV 船体惯性矩阵: m=2.0, l=0.3, w=0.15, h=0.1
             Ixx = m*(w²+h²)/12 = 2*(0.0225+0.01)/12 ≈ 0.00542
             Iyy = m*(l²+h²)/12 = 2*(0.09+0.01)/12 ≈ 0.0167
             Izz = m*(l²+w²)/12 = 2*(0.09+0.0225)/12 ≈ 0.01875 -->
        <inertial>
            <mass value="${hull_mass}" />
            <inertia ixx="${hull_mass*(hull_width*hull_width + hull_height*hull_height)/12}" ixy="0" ixz="0"
                iyy="${hull_mass*(hull_length*hull_length + hull_height*hull_height)/12}" iyz="0"
                izz="${hull_mass*(hull_length*hull_length + hull_width*hull_width)/12}" />
        </inertial>
    </link>
    <gazebo reference="base_link">
        <material>Gazebo/Blue</material>
    </gazebo>

    <!-- 2.2 joint -->
    <joint name="link2footprint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0 0 ${hull_joint_z}" rpy="0 0 0"/>
    </joint>

    <!-- 3. 推进器参数 -->
    <xacro:property name="thruster_radius" value="0.05" />
    <xacro:property name="thruster_length" value="0.15" />
    <xacro:property name="thruster_mass" value="0.5" />

    <!-- 3.1 左推进器 -->
    <link name="thruster_left">
        <visual>
            <geometry>
                <cylinder radius="${thruster_radius}" length="${thruster_length}" />
            </geometry>
            <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
            <material name="thruster_color">
                <color rgba="0.5 0.5 0.5 0.5" />
            </material>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="${thruster_radius}" length="${thruster_length}" />
            </geometry>
            <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
        </collision>
        <xacro:cylinder_inertial_matrix m="${thruster_mass}" r="${thruster_radius}" h="${thruster_length}"/>
    </link>
    <gazebo reference="thruster_left">
        <material>Gazebo/Gray</material>
    </gazebo>

    <joint name="thruster_left2base" type="fixed">
        <parent link="base_link"/>
        <child link="thruster_left"/>
        <origin xyz="-0.15 0.075 0" rpy="0 0 0"/>
    </joint>

    <!-- 3.2 右推进器 -->
    <link name="thruster_right">
        <visual>
            <geometry>
                <cylinder radius="${thruster_radius}" length="${thruster_length}" />
            </geometry>
            <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
            <material name="thruster_color">
                <color rgba="0.5 0.5 0.5 0.5" />
            </material>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="${thruster_radius}" length="${thruster_length}" />
            </geometry>
            <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
        </collision>
        <xacro:cylinder_inertial_matrix m="${thruster_mass}" r="${thruster_radius}" h="${thruster_length}"/>
    </link>
    <gazebo reference="thruster_right">
        <material>Gazebo/Gray</material>
    </gazebo>

    <joint name="thruster_right2base" type="fixed">
        <parent link="base_link"/>
        <child link="thruster_right"/>
        <origin xyz="-0.15 -0.075 0" rpy="0 0 0"/>
    </joint>

</robot>